{
  "name": "expendables-system",
  "version": "0.1.0",
  "private": true,
  "description": "Expendables Client Request Management System \u2014 client portal, agent/developer workspace and admin console for EXPENDABLES (PVT) LTD",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed/index.ts",
    "db:reset": "tsx db/reset.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rls": "tsx db/policies/run-pgtap.ts",
    "test:headers": "tsx tests/headers/check-headers.ts",
    "security": "pnpm audit --audit-level=high",
    "cron": "tsx lib/jobs/cli.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-virtual": "3.14.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "file-type": "22.1.0",
    "lucide-react": "1.45.0",
    "luxon": "3.7.2",
    "motion": "13.2.0",
    "next": "16.3.5",
    "otpauth": "9.5.2",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwind-merge": "3.6.0",
    "unified": "11.0.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.5",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "type": "module"
}
